# Copy to .env.local (gitignored) and fill in. Never paste these into chat.
# The Terraform providers read RENDER_API_KEY, RENDER_OWNER_ID and TEMPORAL_CLOUD_API_KEY directly; the infra scripts pass the rest in as Terraform variables.

# Render: Account Settings → API Keys; the owner ID is the workspace ID (starts with "tea-" or "usr-")
RENDER_API_KEY=
RENDER_OWNER_ID=

# Temporal Cloud: Settings → API Keys (an account-level key for Terraform; the worker's key is created by Terraform)
TEMPORAL_CLOUD_API_KEY=

# Anthropic: copied from the project's existing key when the app is set up
ANTHROPIC_API_KEY=
