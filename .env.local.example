# Copy to .env.local (gitignored) and fill in. Never paste these into chat.
# The Terraform providers read RENDER_API_KEY, RENDER_OWNER_ID and TEMPORAL_CLOUD_API_KEY directly; the infra scripts pass the rest in as Terraform variables.
# scripts/tfvars_from_env.sh copies the four Render and Temporal Cloud keys into infra/terraform/terraform.tfvars,
# which then wins over what scripts/tf.sh passes from here.

# Render: Account Settings → API Keys; the owner ID is the workspace ID (starts with "tea-" or "usr-")
RENDER_API_KEY=
RENDER_OWNER_ID=

# Temporal Cloud: Settings → API Keys (an account-level key for Terraform; the worker's key is created by Terraform)
TEMPORAL_CLOUD_API_KEY=
# The account ID in Temporal Cloud's namespace addresses (<namespace>.<account>.tmprl.cloud); scripts/tf.sh passes it to Terraform
TEMPORAL_CLOUD_ACCOUNT_ID=

# Anthropic: copied from the project's existing key when the app is set up
ANTHROPIC_API_KEY=
# The hosted demo's key, from its own workspace; only scripts/tf.sh reads it, as Terraform's anthropic_api_key
# (which reaches the Render worker's env alone). anthropic_api_key in terraform.tfvars wins over it.
PROD_ANTHROPIC_API_KEY=

# --- App settings (read by harmony.config; `make env-local` appends the local defaults
# below and generates SESSION_SECRET and ADMIN_SECRET without printing them) ---

# Database. Plain postgresql:// URLs. DATABASE_DIRECT_URL bypasses any pooler (LISTEN, migrations).
DATABASE_URL=postgresql://harmony:harmony@localhost:5432/harmony
DATABASE_DIRECT_URL=postgresql://harmony:harmony@localhost:5432/harmony

# Temporal. Local Compose dev server; TEMPORAL_API_KEY is set only for Temporal Cloud.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=

# Model. scripted makes no API calls; live spends money against the $200 dev budget.
# Production is live only (Terraform sets it). Locally every role runs on MODEL_OVERRIDE;
# MODEL_OVERRIDE=none runs the production mix (Opus 5.5 and Haiku 5.5).
MODEL_MODE=scripted
MODEL_OVERRIDE=claude-haiku-5-5
# Where scripted mode reads its cassettes (default: tests/fixtures/cassettes in the repo)
# CASSETTE_DIR=

# Spend. The shared ledger at the project root; the budget guard never creates it.
SPEND_LEDGER_PATH=/Users/willjack/Projects/ant-project/spend_ledger.jsonl
SPEND_PROJECT=harmony
DEV_BUDGET_USD=200
ALERT_THRESHOLDS=50,100,200

# Worker capacity. Terraform sets 12, 5 and 4 on the hosted worker.
WORKER_MODEL_CONCURRENCY=4
# Model-activity starts per second
WORKER_MODEL_RATE=2.0
# Slots on the harmony-chat queue (internal Claude's turns)
WORKER_CHAT_CONCURRENCY=2

# App
APP_ENV=local
SESSION_SECRET=
# The master passcode, optional locally: setting it gates `make dev`; `harmony run` unlocks itself.
# 16+ printable ASCII characters, no whitespace at either end (production's rule).
ACCESS_CODE=
# The header that names a visitor's IP for the per-client cap: x-forwarded-for, true-client-ip or cf-connecting-ip
CLIENT_IP_HEADER=x-forwarded-for
# Guards /api/admin/* (scripts/hosted_admin.sh sends it as X-Admin-Secret)
ADMIN_SECRET=
SCENARIO_ANCHOR=2026-10-26
# BUILD_SHA= (optional; defaults to RENDER_GIT_COMMIT, else `git rev-parse HEAD`)

# Object storage. localfs for local dev and unit tests; s3 for MinIO (Compose profile "storage", Render).
# Local MinIO (`docker compose --profile storage up -d --build minio`): OBJECT_STORE=s3,
# S3_ENDPOINT_URL=http://localhost:9000, S3_ACCESS_KEY_ID=harmony, S3_SECRET_ACCESS_KEY=harmony-local-only
OBJECT_STORE=localfs
S3_ENDPOINT_URL=
S3_BUCKET=harmony
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
